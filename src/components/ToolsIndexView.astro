---
import ToolShell from './ToolShell.astro';
import { localePath, type Lang } from '@/consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy =
  lang === 'zh'
    ? {
        title: '小工具',
        description:
          '免费、纯前端的网络与运维小工具。全部在浏览器本地计算，不上传任何数据，也不跟踪你。',
        tools: [
          {
            slug: 'ipv6',
            name: 'IPv6 地址计算器',
            desc: '把 IPv6 地址在压缩形式与完整展开之间互相转换，并判断地址类型（环回、链路本地、ULA、全局单播、映射地址等）。',
          },
          {
            slug: 'subnet',
            name: 'IPv4 子网计算器',
            desc: '输入 IP/前缀，算出网络地址、广播地址、掩码、可用主机范围与地址数量，并判断地址类型。',
          },
          {
            slug: 'bases',
            name: '进制转换器',
            desc: '在二/八/十/十六进制之间转换，查看 64 位排布与各字宽下的有符号值，并可逐位翻转。',
          },
          {
            slug: 'endian',
            name: '字节序可视化',
            desc: '同一个整数或浮点数在小端/大端下的字节排布，附 IEEE-754 字段分解。',
          },
          {
            slug: 'crc',
            name: 'CRC 校验计算器',
            desc: '对文本或十六进制字节计算 CRC-32、CRC-32C、CRC-16/MODBUS、CCITT、XMODEM 与 CRC-8。',
          },
          {
            slug: 'chmod',
            name: 'chmod 权限计算器',
            desc: '八进制 ⇄ 符号权限，含 setuid/setgid/sticky，并给出对应的 chmod 命令。',
          },
          {
            slug: 'encoding',
            name: 'Base64 / URL / Hex 编解码',
            desc: '对 Base64、URL 百分号编码、十六进制与 HTML 实体做编解码（按 UTF-8 字节）。',
          },
          {
            slug: 'cron',
            name: 'cron 表达式解释器',
            desc: '把 5 字段 cron 表达式翻译成人话，并算出接下来 5 次运行时间。',
          },
          {
            slug: 'harden',
            name: 'systemd 加固生成器',
            desc: '勾选加固项，得到可直接粘贴的 unit 文件——每一项旁边都写着它的代价。',
          },
          {
            slug: 'nginx',
            name: 'nginx 反向代理生成器',
            desc: '带 TLS、响应头、缓存与限速的反向代理 server 块——拆成 http/server 两段，保证 nginx 真的能启动。',
          },
        ],
        note: '更多工具会陆续加入——如果你想要某个特定工具，欢迎来信。',
      }
    : {
        title: 'Tools',
        description:
          'Free, client-side networking utilities. Everything is computed locally in your browser — nothing is uploaded, nothing tracks you.',
        tools: [
          {
            slug: 'ipv6',
            name: 'IPv6 address calculator',
            desc: 'Convert an IPv6 address between compressed and fully expanded forms, and identify its type (loopback, link-local, ULA, global unicast, mapped, …).',
          },
          {
            slug: 'subnet',
            name: 'IPv4 subnet calculator',
            desc: 'Enter an IP/prefix to get the network, broadcast, netmask, usable host range and host count — plus the address type.',
          },
          {
            slug: 'bases',
            name: 'Number base converter',
            desc: 'Convert between binary, octal, decimal and hex, see the 64-bit layout and the signed value at each width, and toggle individual bits.',
          },
          {
            slug: 'endian',
            name: 'Endianness visualizer',
            desc: 'See the same integer or float laid out in bytes under little- and big-endian, with the IEEE-754 field breakdown.',
          },
          {
            slug: 'crc',
            name: 'CRC calculator',
            desc: 'CRC-32, CRC-32C, CRC-16/MODBUS, CCITT, XMODEM and CRC-8 over text or hex bytes.',
          },
          {
            slug: 'chmod',
            name: 'chmod calculator',
            desc: 'Octal ⇄ symbolic file modes, including setuid/setgid/sticky, with the equivalent command.',
          },
          {
            slug: 'encoding',
            name: 'Base64 / URL / Hex encoder',
            desc: 'Encode and decode Base64, URL percent-encoding, hex and HTML entities on UTF-8 bytes.',
          },
          {
            slug: 'cron',
            name: 'cron explainer',
            desc: 'Turn a 5-field cron expression into plain English plus the next five run times.',
          },
          {
            slug: 'harden',
            name: 'systemd hardening generator',
            desc: 'Tick the hardening you want and get a paste-ready unit file — with the cost of every directive written next to it.',
          },
          {
            slug: 'nginx',
            name: 'nginx reverse-proxy generator',
            desc: 'A reverse-proxy server block with TLS, headers, caching and rate limiting — split into http/server so nginx actually starts.',
          },
        ],
        note: 'More tools are coming. If there is one you wish existed, get in touch.',
      };
---

<ToolShell lang={lang} slug="" title={copy.title} description={copy.description}>
  <ul class="tool-index">
    {copy.tools.map((tool) => (
      <li class="tool-index__item">
        <a class="tool-index__name" href={localePath(lang, `/tools/${tool.slug}/`)}>{tool.name}</a>
        <p class="tool-index__desc">{tool.desc}</p>
      </li>
    ))}
  </ul>
  <p class="muted" style="margin-top:2rem;font-size:.9rem">{copy.note}</p>
</ToolShell>

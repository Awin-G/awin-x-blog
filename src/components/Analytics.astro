---
import { SITE } from '@/consts';

// Cookie-less analytics (GoatCounter). Only in production builds.
const enabled = SITE.analytics.goatcounter.enabled && import.meta.env.PROD;
const base = SITE.analytics.goatcounter.base.replace(/\/$/, '');
const code = SITE.analytics.goatcounter.code;
const countUrl = code ? `${base}/count/${code}` : `${base}/count`;
---

{enabled && (
  <script
    is:inline
    data-goatcounter={countUrl}
    async
    src={`${base}/count.js`}
  ></script>
)}

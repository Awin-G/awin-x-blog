---
import { ADSENSE_CLIENT } from '@/consts';

/**
 * Manual Google AdSense unit.
 *
 * With **Auto ads** enabled in the AdSense dashboard you do not need this at all —
 * the `adsbygoogle.js` script in <head> is enough. This component is for placing a
 * unit deliberately: create a display unit in the dashboard, paste its numeric slot
 * id into UNIT_SLOT, and drop `<AdSlot />` where it belongs.
 *
 * While UNIT_SLOT is empty this renders nothing (zero bytes, zero CLS).
 */
interface Props {
  /** `auto` (responsive) | `horizontal` | `rectangle` | `vertical`. */
  format?: string;
  /** Render this instance even while the global switch below is off. */
  enabled?: boolean;
}
// The operator's adaptive (square-capable, full-width-responsive) unit, created
// 2026-10-15. Stored and ready; nothing renders until it is switched on.
const UNIT_SLOT = '7759076601';
// Global switch. Flip to true (or pass `enabled`) to start rendering units.
const ENABLED = false;
const show = (ENABLED || Astro.props.enabled) && UNIT_SLOT !== '';
---

{
  show && (
    <aside class="adslot" aria-label="Advertisement">
      <span class="adslot__label">ad</span>
      <ins
        class="adsbygoogle adslot__unit"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={UNIT_SLOT}
        data-ad-format={Astro.props.format ?? 'auto'}
        data-full-width-responsive="true"
      />
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}

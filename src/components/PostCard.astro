---
import FormattedDate from './FormattedDate.astro';
import { t, type Lang } from '@/consts';
import { postPath, readingTime, tagPath, type Post } from '@/lib/posts';

interface Props {
  post: Post;
  /** Tag to link (defaults to post language). */
  lang?: Lang;
}

const { post } = Astro.props;
const lang = Astro.props.lang ?? post.data.lang;
const tags = post.data.tags.slice(0, 3);
---

<article class="card">
  <h3 class="card__title">
    <a href={postPath(post)}>{post.data.title}</a>
  </h3>
  <p class="card__desc">{post.data.description}</p>
  <div class="card__meta">
    <FormattedDate date={post.data.pubDate} lang={lang} />
    <span aria-hidden="true">·</span>
    <span>{t(lang, 'post.readingTime', { minutes: readingTime(post) })}</span>
  </div>
  {tags.length > 0 && (
    <div class="card__tags">
      {tags.map((tg) => (
        <a class="chip" href={tagPath(lang, tg)}>{tg}</a>
      ))}
    </div>
  )}
</article>

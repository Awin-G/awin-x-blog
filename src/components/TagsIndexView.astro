---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, localePath, type Lang } from '@/consts';
import { tagsOf, tagPath } from '@/lib/posts';
import { tagDescription } from '@/lib/tags';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const tags = await tagsOf(lang);

const alternates: Partial<Record<Lang, string>> = {
  en: localePath('en', '/tags/'),
  zh: localePath('zh', '/tags/'),
};
---

<BaseLayout
  title={t(lang, 'tags.title')}
  description={t(lang, 'tags.description')}
  lang={lang}
  path={localePath(lang, '/tags/')}
  alternates={alternates}
  switchHref={localePath(other, '/tags/')}
  active="tags"
>
  <div class="wrap" style="padding-top:2.5rem">
    <h1>{t(lang, 'tags.title')}</h1>
    <p class="lead">{t(lang, 'tags.description')}</p>
    <ul class="tag-index">
      {tags.map(({ tag, count }) => (
        <li class="tag-index__item">
          <a class="tag-index__name" href={tagPath(lang, tag)}>#{tag}</a>
          <span class="tag-index__count">
            {count === 1 ? t(lang, 'tags.onePost') : t(lang, 'tags.count', { count })}
          </span>
          {tagDescription(tag, lang) && <p class="tag-index__desc">{tagDescription(tag, lang)}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

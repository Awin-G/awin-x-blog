---
import { SITE, t, localePath, type Lang } from '@/consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
const rss = localePath(lang, '/rss.xml');
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <strong>{SITE.name}</strong> · © {year} {SITE.author}.
      <span class="muted">{t(lang, 'footer.builtWith')}</span>
    </div>
    <div class="site-footer__links">
      <a href={localePath(lang, '/start/')}>{t(lang, 'nav.start')}</a>
      <a href={localePath(lang, '/tools/')}>{t(lang, 'nav.tools')}</a>
      <a href={localePath(lang, '/about/')}>{t(lang, 'nav.about')}</a>
      <a href={localePath(lang, '/open/')}>{lang === 'zh' ? '开源账本' : 'Open ledger'}</a>
      <a href={localePath(lang, '/uses/')}>{lang === 'zh' ? '在用' : 'Uses'}</a>
      <a href={localePath(lang, '/support/')}>{lang === 'zh' ? '支持' : 'Support'}</a>
      <a href={rss}>{t(lang, 'footer.feed')}</a>
      <a href={SITE.repo} rel="noopener">Source</a>
      <a href={`mailto:${SITE.email}`}>Contact</a>
    </div>
  </div>
</footer>

---
import type { Lang } from '@/consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L =
  lang === 'zh'
    ? {
        input: '输入 IPv4 地址（可带前缀，如 192.168.1.10/24 或 10.0.0.0/8）',
        placeholder: '例如 192.168.1.10/24',
        network: '网络地址',
        broadcast: '广播地址',
        mask: '子网掩码',
        wildcard: '反掩码',
        range: '可用主机范围',
        hosts: '可用主机数',
        total: '地址总数',
        kind: '地址类型',
        valid: '有效',
        invalid: '无效的 IPv4 地址或前缀',
        hint: '全部在浏览器本地计算，不发送任何数据。',
        samples: '示例',
        kinds: {
          private: '私有地址 (RFC1918)',
          loopback: '环回 (127/8)',
          linklocal: '链路本地 (169.254/16)',
          cgnat: '运营商级 NAT (100.64/10)',
          multicast: '多播 (224/4)',
          reserved: '保留/其它',
          public: '公网地址',
        },
      }
    : {
        input: 'Enter an IPv4 address (optionally with prefix, e.g. 192.168.1.10/24)',
        placeholder: 'e.g. 192.168.1.10/24',
        network: 'Network',
        broadcast: 'Broadcast',
        mask: 'Netmask',
        wildcard: 'Wildcard',
        range: 'Usable host range',
        hosts: 'Usable hosts',
        total: 'Total addresses',
        kind: 'Address type',
        valid: 'valid',
        invalid: 'not a valid IPv4 address / prefix',
        hint: 'Computed locally in your browser — nothing is sent anywhere.',
        samples: 'Try',
        kinds: {
          private: 'Private (RFC 1918)',
          loopback: 'Loopback (127/8)',
          linklocal: 'Link-local (169.254/16)',
          cgnat: 'Carrier-grade NAT (100.64/10)',
          multicast: 'Multicast (224/4)',
          reserved: 'Reserved / other',
          public: 'Public',
        },
      };

const json = JSON.stringify(L.kinds).replace(/'/g, '&#39;');
---

<div class="tool subnet" data-subnet data-kinds={json} data-valid={L.valid} data-invalid={L.invalid}>
  <label for="subnet-in">{L.input}</label>
  <input id="subnet-in" type="text" autocomplete="off" spellcheck="false" placeholder={L.placeholder} value="192.168.1.10/24" />
  <p class="subnet__status" data-status aria-live="polite"></p>

  <div class="subnet__out">
    {[
      ['network', L.network],
      ['broadcast', L.broadcast],
      ['mask', L.mask],
      ['wildcard', L.wildcard],
      ['range', L.range],
      ['hosts', L.hosts],
      ['total', L.total],
      ['kind', L.kind],
    ].map(([k, label]) => (
      <div class="subnet__row">
        <span class="subnet__k">{label}</span>
        <output data-out={k}>—</output>
      </div>
    ))}
  </div>

  <p class="subnet__hint">
    {L.hint} · {L.samples}:
    <button type="button" class="subnet__chip" data-sample="10.0.0.5/8">10/8</button>
    <button type="button" class="subnet__chip" data-sample="172.16.4.20/12">172.16/12</button>
    <button type="button" class="subnet__chip" data-sample="192.168.1.10/24">192.168/24</button>
    <button type="button" class="subnet__chip" data-sample="203.0.113.7/30">203.0.113/30</button>
    <button type="button" class="subnet__chip" data-sample="100.64.1.1/10">CGNAT</button>
  </p>
</div>

<script>
  type Kinds = Record<string, string>;

  const ipToInt = (s: string): number | null => {
    const p = s.split('.');
    if (p.length !== 4) return null;
    let n = 0;
    for (const part of p) {
      if (!/^\d{1,3}$/.test(part) || Number(part) > 255) return null;
      n = (n << 8) | Number(part);
    }
    return n >>> 0;
  };
  const intToIp = (n: number): string => [24, 16, 8, 0].map((s) => (n >>> s) & 255).join('.');

  function classify(ip: number): string {
    const inRange = (base: number, bits: number) => (ip >>> (32 - bits)) === (base >>> (32 - bits));
    if (inRange(0x7f000000, 8)) return 'loopback';
    if (inRange(0x0a000000, 8)) return 'private';
    if (inRange(0xac100000, 12)) return 'private';
    if (inRange(0xc0a80000, 16)) return 'private';
    if (inRange(0xa9fe0000, 16)) return 'linklocal';
    if (inRange(0x64400000, 10)) return 'cgnat';
    if (inRange(0xe0000000, 4)) return 'multicast';
    if (inRange(0xf0000000, 4)) return 'reserved';
    if (inRange(0x00000000, 8)) return 'reserved';
    if (inRange(0xc0000000, 4) || inRange(0xc0000200, 24)) return 'reserved';
    return 'public';
  }

  document.querySelectorAll<HTMLElement>('[data-subnet]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('input[type=text]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const kinds: Kinds = JSON.parse(root.dataset.kinds || '{}');
    const validText = root.dataset.valid || 'valid';
    const invalidText = root.dataset.invalid || 'invalid';
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const keys = ['network', 'broadcast', 'mask', 'wildcard', 'range', 'hosts', 'total', 'kind'];

    function render() {
      const raw = input.value.trim();
      const [ipStr, pfxStr] = raw.includes('/') ? raw.split('/') : [raw, '32'];
      const ip = ipToInt(ipStr);
      const pfx = Number(pfxStr);
      if (ip === null || !Number.isInteger(pfx) || pfx < 0 || pfx > 32) {
        status.textContent = raw ? invalidText : '';
        status.dataset.state = 'bad';
        keys.forEach((k) => (out(k).textContent = '—'));
        return;
      }
      status.textContent = validText;
      status.dataset.state = 'ok';

      const mask = pfx === 0 ? 0 : (0xffffffff << (32 - pfx)) >>> 0;
      const wildcard = ~mask >>> 0;
      const network = (ip & mask) >>> 0;
      const broadcast = (network | wildcard) >>> 0;
      const total = 2 ** (32 - pfx);

      let first = network;
      let last = broadcast;
      let usable = total - 2;
      if (pfx >= 31) {
        // /31 point-to-point, /32 single host
        usable = pfx === 32 ? 1 : 2;
        first = network;
        last = broadcast;
      } else {
        first = (network + 1) >>> 0;
        last = (broadcast - 1) >>> 0;
      }

      out('mask').textContent = intToIp(mask);
      out('wildcard').textContent = intToIp(wildcard);
      out('network').textContent = `${intToIp(network)}/${pfx}`;
      out('broadcast').textContent = intToIp(broadcast);
      out('range').textContent =
        pfx === 32 ? intToIp(network) : `${intToIp(first)} – ${intToIp(last)}`;
      out('hosts').textContent = usable.toLocaleString();
      out('total').textContent = total.toLocaleString();
      out('kind').textContent = kinds[classify(ip)] || classify(ip);
    }

    input.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.sample!;
        render();
      }),
    );
    render();
  });
</script>

<style>
  .subnet__out {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .subnet__row {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.92rem;
  }
  .subnet__k {
    color: var(--fg-muted);
    font-weight: 600;
  }
  .subnet__row output {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    word-break: break-all;
  }
  .subnet__status {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .subnet__status[data-state='ok'] {
    color: var(--accent);
  }
  .subnet__status[data-state='bad'] {
    color: #d9534f;
  }
  .subnet__hint {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: var(--fg-faint);
  }
  .subnet__chip {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin: 0 0.15rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg-muted);
    cursor: pointer;
  }
  .subnet__chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 34rem) {
    .subnet__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>

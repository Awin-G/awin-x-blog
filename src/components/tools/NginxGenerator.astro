---
/**
 * nginx reverse-proxy config generator.
 *
 * The point of difference from the usual generators: some of these directives are
 * only legal in the `http` context (proxy_cache_path, limit_req_zone, log_format),
 * so the output is split into an http{} block and a server{} block. Putting a
 * limit_req_zone inside a server block is one of the classic nginx failures, and
 * it is called out in the notes rather than hidden.
 */
import type { Lang } from '@/consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';

type Item = {
  id: string;
  group: string;
  label: string;
  note: string;
  on: boolean;
};

const GROUPS = zh
  ? {
      tls: 'TLS',
      proxy: '反向代理',
      perf: '性能与缓存',
      sec: '安全',
      limits: '限制',
    }
  : {
      tls: 'TLS',
      proxy: 'Reverse proxy',
      perf: 'Performance and caching',
      sec: 'Security',
      limits: 'Limits',
    };

const L = zh
  ? {
      title: 'nginx 反向代理配置生成器',
      domain: '域名',
      upstream: '上游（每行一个 host:port，多个即负载均衡）',
      mode: '站点类型',
      proxyMode: '反向代理到上游',
      staticMode: '只服务静态文件',
      spaMode: '单页应用（SPA 回退到 index.html）',
      cert: '证书来源',
      certLets: "Let's Encrypt（certbot 的 live 路径）",
      certCustom: '自定义证书路径',
      enable: '要启用的东西',
      httpBlock: '这些必须放在 http { } 里（不是 server 里）',
      serverBlock: 'server 块',
      copy: '复制',
      presets: '预设',
      presetWeb: '典型 Web 应用',
      presetApi: 'JSON API',
      presetSpa: 'SPA + 静态资源',
      presetNone: '全不选',
      warn: '和加固一样：不是越多越好。每条都写了它的代价，尤其是"这条指令必须放在哪个上下文里"——放错了 nginx 会直接拒绝启动。',
      httpNone: '（当前选项不需要任何 http 级指令）',
    }
  : {
      title: 'nginx reverse-proxy config generator',
      domain: 'Domain',
      upstream: 'Upstream (one host:port per line; more than one means load balancing)',
      mode: 'Site kind',
      proxyMode: 'Reverse proxy to an upstream',
      staticMode: 'Serve static files only',
      spaMode: 'Single-page app (fall back to index.html)',
      cert: 'Certificate source',
      certLets: "Let's Encrypt (certbot live path)",
      certCustom: 'Custom certificate paths',
      enable: 'What to enable',
      httpBlock: 'These must go in http { } — not in server',
      serverBlock: 'server block',
      copy: 'Copy',
      presets: 'Presets',
      presetWeb: 'Typical web app',
      presetApi: 'JSON API',
      presetSpa: 'SPA + static assets',
      presetNone: 'None',
      warn: 'As with hardening, more is not better. Every item states its cost — especially which context the directive is legal in, because putting one in the wrong place makes nginx refuse to start.',
      httpNone: '(the current selection needs no http-level directives)',
    };

const ITEMS: Item[] = [
  // ---- TLS
  { id: 'redirect', group: 'tls', on: true,
    label: zh ? 'HTTP 跳转到 HTTPS（301）' : 'Redirect HTTP to HTTPS (301)',
    note: zh ? '一个独立的 80 端口 server 块。没有它，用 http:// 访问的人会看到连接被拒绝，而不是被跳转。' : 'A separate port-80 server block. Without it, anyone typing http:// gets a connection refused rather than a redirect.' },
  { id: 'tlsmodern', group: 'tls', on: true,
    label: zh ? '只允许 TLS 1.2 / 1.3' : 'TLS 1.2 / 1.3 only',
    note: zh ? '关掉 TLS 1.0/1.1。极老的客户端（XP 上的 IE）会连不上——这是有意的。' : 'Disables TLS 1.0/1.1. Very old clients (IE on XP) cannot connect — deliberately.' },
  { id: 'hsts', group: 'tls', on: true,
    label: zh ? 'HSTS（max-age 一年）' : 'HSTS (one-year max-age)',
    note: zh ? '浏览器从此**拒绝**用 http 访问这个域，直到过期。别轻易加 preload——那是不可逆的。' : 'Browsers will **refuse** plain http to this domain until it expires. Do not add preload casually — that part is effectively irreversible.' },
  { id: 'ocsp', group: 'tls', on: false,
    label: zh ? 'OCSP stapling' : 'OCSP stapling',
    note: zh ? '需要 `ssl_trusted_certificate`（用 fullchain）和一个 `resolver`，否则 nginx 会**静默地不装订**——你以为开了，其实没开。' : 'Needs `ssl_trusted_certificate` (the fullchain) and a `resolver`, or nginx silently staples nothing — you think it is on and it is not.' },
  { id: 'http2', group: 'tls', on: true,
    label: zh ? 'HTTP/2' : 'HTTP/2',
    note: zh ? '一个 listen 上的一个词。它让一条连接承载多个请求，是长链路上最划算的一行配置。**注意**：nginx 1.25.1 起 `listen ... http2` 已被标记为过时（改推 `http2 on;`），但旧发行版（如 Ubuntu 24.04 的 1.24）还不认识新写法——所以这里给的是兼容性更好的旧写法，它仍能工作，只是新版本会打一条警告。' : 'One word on the listen line. It lets one connection carry many requests — the cheapest latency win on a long link. **Note**: since nginx 1.25.1 the `listen ... http2` form is deprecated in favour of `http2 on;`, but older distros (nginx 1.24 on Ubuntu 24.04, for instance) do not understand the new form — so this emits the compatible one, which still works and merely warns on newer builds.' },

  // ---- proxy
  { id: 'proxyheaders', group: 'proxy', on: true,
    label: zh ? '转发 Host 与 X-Forwarded-*' : 'Forward Host and X-Forwarded-*',
    note: zh ? '不加这些，上游看到的客户端 IP 永远是 127.0.0.1。**同时意味着你必须信任上游只从这个 nginx 收到流量**，否则客户端可以伪造头。' : 'Without these the upstream sees every client as 127.0.0.1. It also means you must trust that the upstream only ever receives traffic from this nginx — otherwise a client can forge the headers.' },
  { id: 'ws', group: 'proxy', on: false,
    label: zh ? 'WebSocket 升级' : 'WebSocket upgrade',
    note: zh ? '用 `map` 把 Connection 头从 "upgrade" 映射出来，而不是硬编码。硬编码会破坏普通请求的 keepalive。' : 'Uses a `map` to derive the Connection header instead of hardcoding "upgrade" — hardcoding breaks keepalive on ordinary requests.' },
  { id: 'timeouts', group: 'proxy', on: true,
    label: zh ? '代理超时（60s）' : 'Proxy timeouts (60s)',
    note: zh ? '默认 60 秒。长任务（导出、大查询）会 504——把它们改成 300s，但要清楚：慢的上游会占住 worker。' : 'The default is 60s. Long jobs (exports, big queries) will 504 — raise them to 300s, but know that slow upstreams hold a worker.' },
  { id: 'nobuffering', group: 'proxy', on: false,
    label: zh ? '关闭响应缓冲（SSE / 流式）' : 'Disable response buffering (SSE / streaming)',
    note: zh ? '`proxy_buffering off` 才能让事件**实时**到达浏览器。代价是每个连接占一个 worker，高并发下更贵。' : '`proxy_buffering off` is what makes events arrive **live**. The cost is one worker per connection, which gets expensive under concurrency.' },
  { id: 'uploads', group: 'proxy', on: false,
    label: zh ? '允许大上传（100M）' : 'Allow large uploads (100M)',
    note: zh ? '`client_max_body_size` 默认只有 1M。传大文件会得到一个**413**，而日志里往往看不出原因。' : '`client_max_body_size` defaults to just 1M. Large uploads get a **413** and the log often does not make the reason obvious.' },

  // ---- perf and caching
  { id: 'gzip', group: 'perf', on: true,
    label: zh ? 'gzip 压缩' : 'gzip compression',
    note: zh ? '省带宽。**别压缩已经压过的类型**（图片/视频），那只是浪费 CPU。brotli 更好但要额外模块。' : 'Saves bandwidth. **Do not compress already-compressed types** (images, video) — that only burns CPU. brotli is better but needs an extra module.' },
  { id: 'cache', group: 'perf', on: false,
    label: zh ? '代理缓存' : 'Proxy cache',
    note: zh ? '需要一个 http 级的 `proxy_cache_path`（所以它在上面那个块里）。**只缓存 GET**；带 Cookie 或 Set-Cookie 的响应必须绕开，否则你会把一个人的会话发给另一个人。' : 'Needs an http-level `proxy_cache_path` (hence the block above). **Only GET is cached**; responses with Cookie or Set-Cookie must bypass it, or you will serve one person’s session to another.' },
  { id: 'staticcache', group: 'perf', on: true,
    label: zh ? '静态资源长缓存' : 'Long cache for static assets',
    note: zh ? '对 /assets/ 之类的路径设一年 `immutable`。前提是文件名带内容哈希——否则更新后用户永远拿到旧的。' : 'A one-year `immutable` header for paths like /assets/. Only valid if filenames carry a content hash — otherwise users keep the old file forever.' },

  // ---- security
  { id: 'secheaders', group: 'sec', on: true,
    label: zh ? '基础安全响应头' : 'Baseline security headers',
    note: zh ? 'nosniff、Referrer-Policy、Permissions-Policy。没有副作用，几乎所有站点都该有。' : 'nosniff, Referrer-Policy, Permissions-Policy. No downside; almost every site should have these.' },
  { id: 'csp', group: 'sec', on: false,
    label: zh ? 'CSP（先只报告，不拦截）' : 'CSP (report-only first)',
    note: zh ? '**默认给的是 `Content-Security-Policy-Report-Only`**，因为它会弄坏内联脚本、CDN、内联样式。先只报告、看违例、再收紧。' : '**Emits `Content-Security-Policy-Report-Only` by default**, because CSP breaks inline scripts, CDNs and inline styles. Report first, watch the violations, then tighten.' },
  { id: 'hideversion', group: 'sec', on: true,
    label: zh ? '隐藏版本号' : 'Hide the version string',
    note: zh ? '`server_tokens off`。这不是安全措施，只是少给扫描器一点信息。' : '`server_tokens off`. This is not a security control — it just gives scanners slightly less.' },

  // ---- limits
  { id: 'ratelimit', group: 'limits', on: false,
    label: zh ? '限速（每 IP 10 r/s）' : 'Rate limit (10 r/s per IP)',
    note: zh ? '`limit_req_zone` **必须放在 http 块里**，放在 server 里 nginx 会拒绝启动——这是最经典的 nginx 报错之一。突发用 `burst`，并且注意：限速是按 IP 的，NAT 后面的一整个办公室会共享它。' : '`limit_req_zone` **must live in the http block**; inside a server block nginx refuses to start — one of the classic nginx errors. Use `burst` for spikes, and note the limit is per IP, so an entire office behind one NAT shares it.' },
  { id: 'timeouts2', group: 'limits', on: true,
    label: zh ? '客户端超时（慢连接防护）' : 'Client timeouts (slow-connection defence)',
    note: zh ? '`client_body_timeout` / `client_header_timeout` 收紧到 10–15 秒，防止半开的连接占住 worker。' : 'Tightens `client_body_timeout` / `client_header_timeout` to 10–15s so half-open connections stop holding workers.' },
];

const PRESETS: Record<string, string[]> = {
  none: [],
  web: ['redirect', 'tlsmodern', 'hsts', 'http2', 'proxyheaders', 'timeouts', 'gzip', 'staticcache', 'secheaders', 'hideversion', 'timeouts2'],
  api: ['redirect', 'tlsmodern', 'hsts', 'http2', 'proxyheaders', 'timeouts', 'nobuffering', 'gzip', 'secheaders', 'hideversion', 'ratelimit', 'timeouts2'],
  spa: ['redirect', 'tlsmodern', 'hsts', 'http2', 'gzip', 'staticcache', 'secheaders', 'hideversion', 'timeouts2'],
};
---

<div class="tool ngx" data-ngx data-labels={JSON.stringify({ items: ITEMS, groups: GROUPS, presets: PRESETS })}>
  <div class="ngx__row">
    <label for="ngx-domain">{L.domain}</label>
    <input id="ngx-domain" type="text" autocomplete="off" spellcheck="false" value="app.example.com" data-domain />
  </div>

  <div class="ngx__row">
    <label for="ngx-up">{L.upstream}</label>
    <textarea id="ngx-up" rows="2" spellcheck="false" data-up>127.0.0.1:3000</textarea>
  </div>

  <div class="ngx__row">
    <label for="ngx-mode">{L.mode}</label>
    <select id="ngx-mode" data-mode>
      <option value="proxy">{L.proxyMode}</option>
      <option value="static">{L.staticMode}</option>
      <option value="spa">{L.spaMode}</option>
    </select>
  </div>

  <div class="ngx__row">
    <label for="ngx-cert">{L.cert}</label>
    <select id="ngx-cert" data-cert>
      <option value="lets">{L.certLets}</option>
      <option value="custom">{L.certCustom}</option>
    </select>
  </div>

  <p class="ngx__presets">
    {L.presets}:
    <button type="button" class="ngx__chip" data-preset="web">{L.presetWeb}</button>
    <button type="button" class="ngx__chip" data-preset="api">{L.presetApi}</button>
    <button type="button" class="ngx__chip" data-preset="spa">{L.presetSpa}</button>
    <button type="button" class="ngx__chip" data-preset="none">{L.presetNone}</button>
  </p>

  <p class="ngx__section">{L.enable}</p>
  <div class="ngx__items" data-items></div>

  <p class="ngx__section">{L.httpBlock}</p>
  <div class="ngx__out">
    <button type="button" class="ngx__copy" data-copy-http>{L.copy}</button>
    <pre data-out-http><code></code></pre>
  </div>

  <p class="ngx__section">{L.serverBlock}</p>
  <div class="ngx__out">
    <button type="button" class="ngx__copy" data-copy>{L.copy}</button>
    <pre data-out><code></code></pre>
  </div>

  <p class="ngx__warn">{L.warn}</p>
</div>

<script>
  type Item = { id: string; group: string; label: string; note: string; on: boolean };

  document.querySelectorAll<HTMLElement>('[data-ngx]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.labels || '{}');
    const items: Item[] = cfg.items || [];
    const groups: Record<string, string> = cfg.groups || {};
    const presets: Record<string, string[]> = cfg.presets || {};
    const itemsEl = root.querySelector<HTMLElement>('[data-items]')!;
    const httpEl = root.querySelector<HTMLElement>('[data-out-http] code')!;
    const srvEl = root.querySelector<HTMLElement>('[data-out] code')!;
    const domainEl = root.querySelector<HTMLInputElement>('[data-domain]')!;
    const upEl = root.querySelector<HTMLTextAreaElement>('[data-up]')!;
    const modeEl = root.querySelector<HTMLSelectElement>('[data-mode]')!;
    const certEl = root.querySelector<HTMLSelectElement>('[data-cert]')!;

    const state = new Map<string, boolean>(items.map((i) => [i.id, i.on]));
    const on = (id: string) => !!state.get(id);

    const byGroup = new Map<string, Item[]>();
    items.forEach((i) => {
      if (!byGroup.has(i.group)) byGroup.set(i.group, []);
      byGroup.get(i.group)!.push(i);
    });
    byGroup.forEach((group, g) => {
      const wrap = document.createElement('div');
      wrap.className = 'ngx__group';
      const h = document.createElement('p');
      h.className = 'ngx__cat';
      h.textContent = groups[g] || g;
      wrap.appendChild(h);
      group.forEach((it) => {
        const row = document.createElement('div');
        row.className = 'ngx__item';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.id = `ngx-${it.id}`;
        cb.checked = on(it.id);
        cb.addEventListener('change', () => {
          state.set(it.id, cb.checked);
          row.classList.toggle('ngx__item--off', !cb.checked);
          render();
        });
        const lab = document.createElement('label');
        lab.htmlFor = cb.id;
        lab.innerHTML = `<span class="ngx__label">${it.label}</span><span class="ngx__note">${it.note}</span>`;
        row.classList.toggle('ngx__item--off', !cb.checked);
        row.appendChild(cb);
        row.appendChild(lab);
        wrap.appendChild(row);
      });
      itemsEl.appendChild(wrap);
    });

    function render() {
      const domain = domainEl.value.trim() || 'app.example.com';
      const upstreams = upEl.value.split('\n').map((s) => s.trim()).filter(Boolean);
      const mode = modeEl.value;
      const lets = certEl.value === 'lets';
      const certPath = lets
        ? `/etc/letsencrypt/live/${domain}/fullchain.pem`
        : `/etc/ssl/${domain}/fullchain.pem`;
      const keyPath = lets
        ? `/etc/letsencrypt/live/${domain}/privkey.pem`
        : `/etc/ssl/${domain}/privkey.pem`;

      // ---------- http-context directives ----------
      const http: string[] = [];
      if (on('ratelimit')) {
        http.push('# Required in the http context — nginx refuses to start if this is inside a server block.');
        http.push('limit_req_zone $binary_remote_addr zone=perip:10m rate=10r/s;');
      }
      if (on('cache')) {
        http.push('proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=appcache:10m max_size=1g inactive=60m use_temp_path=off;');
      }
      if (on('ws')) {
        http.push('# Map so ordinary requests keep a sane Connection header.');
        http.push('map $http_upgrade $connection_upgrade {');
        http.push('    default upgrade;');
        http.push("    ''      close;");
        http.push('}');
      }
      if (on('gzip')) {
        http.push('gzip on;');
        http.push('gzip_vary on;');
        http.push('gzip_min_length 1024;');
        http.push('gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;');
      }
      httpEl.textContent = http.length ? http.join('\n') + '\n' : '';

      // ---------- server blocks ----------
      const out: string[] = [];

      if (on('redirect')) {
        out.push('# --- HTTP: redirect everything to HTTPS ---');
        out.push('server {');
        out.push('    listen 80;');
        out.push('    listen [::]:80;');
        out.push(`    server_name ${domain};`);
        out.push('    location /.well-known/acme-challenge/ { root /var/www/certbot; }');
        out.push('    location / { return 301 https://$host$request_uri; }');
        out.push('}');
        out.push('');
      }

      out.push('# --- HTTPS ---');
      out.push('server {');
      out.push(on('http2') ? '    listen 443 ssl http2;' : '    listen 443 ssl;');
      out.push(on('http2') ? '    listen [::]:443 ssl http2;' : '    listen [::]:443 ssl;');
      out.push(`    server_name ${domain};`);
      out.push('');
      out.push(`    ssl_certificate     ${certPath};`);
      out.push(`    ssl_certificate_key ${keyPath};`);
      if (on('tlsmodern')) {
        out.push('    ssl_protocols TLSv1.2 TLSv1.3;');
        out.push('    ssl_prefer_server_ciphers off;');
        out.push('    ssl_session_cache shared:SSL:10m;');
        out.push('    ssl_session_timeout 1d;');
      }
      if (on('ocsp')) {
        out.push(`    ssl_trusted_certificate ${certPath};`);
        out.push('    ssl_stapling on;');
        out.push('    ssl_stapling_verify on;');
        out.push('    resolver 1.1.1.1 8.8.8.8 valid=300s;');
      }
      if (on('hsts')) {
        out.push('    add_header Strict-Transport-Security "max-age=31536000" always;');
      }
      if (on('hideversion')) {
        out.push('    server_tokens off;');
      }

      if (on('secheaders')) {
        out.push('');
        out.push('    add_header X-Content-Type-Options "nosniff" always;');
        out.push('    add_header Referrer-Policy "strict-origin-when-cross-origin" always;');
        out.push('    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;');
      }
      if (on('csp')) {
        out.push('    # Report-only first: CSP breaks inline scripts, CDNs and inline styles.');
        out.push('    add_header Content-Security-Policy-Report-Only "default-src \'self\'; img-src \'self\' data:; style-src \'self\' \'unsafe-inline\'; report-uri /csp-report" always;');
      }

      if (on('uploads')) {
        out.push('');
        out.push('    client_max_body_size 100m;');
      }
      if (on('timeouts2')) {
        out.push('    client_body_timeout 15s;');
        out.push('    client_header_timeout 15s;');
      }
      if (on('ratelimit')) {
        out.push('');
        out.push('    # burst absorbs spikes; nodelay serves them immediately instead of queueing.');
        out.push('    limit_req zone=perip burst=20 nodelay;');
        out.push('    limit_req_status 429;');
      }

      if (mode === 'proxy') {
        out.push('');
        if (upstreams.length > 1) {
          out.push('# More than one server: nginx round-robins by default. Add "least_conn;"');
          out.push('# if the backends differ in speed — round-robin will keep hitting a slow one.');
          out.push('upstream app_backend {');
          upstreams.forEach((u) => out.push(`    server ${u};`));
          out.push('}');
          out.push('');
        }
        out.push('    location / {');
        if (upstreams.length > 1) {
          out.push('        proxy_pass http://app_backend;');
        } else {
          out.push(`        proxy_pass http://${upstreams[0] || '127.0.0.1:3000'};`);
        }
        if (on('proxyheaders')) {
          out.push('        proxy_set_header Host              $host;');
          out.push('        proxy_set_header X-Real-IP         $remote_addr;');
          out.push('        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;');
          out.push('        proxy_set_header X-Forwarded-Proto $scheme;');
        }
        if (on('ws')) {
          out.push('        proxy_http_version 1.1;');
          out.push('        proxy_set_header Upgrade    $http_upgrade;');
          out.push('        proxy_set_header Connection $connection_upgrade;');
        }
        if (on('timeouts')) {
          out.push('        proxy_connect_timeout 10s;');
          out.push('        proxy_send_timeout    60s;');
          out.push('        proxy_read_timeout    60s;');
        }
        if (on('nobuffering')) {
          out.push('        proxy_buffering off;');
          out.push('        proxy_cache off;');
        }
        if (on('cache')) {
          out.push('        proxy_cache appcache;');
          out.push('        proxy_cache_valid 200 301 302 10m;');
          out.push('        proxy_cache_use_stale error timeout updating;');
          out.push('        # Never cache a response that carries a session.');
          out.push('        proxy_no_cache $cookie_session $http_authorization;');
          out.push('        add_header X-Cache-Status $upstream_cache_status;');
        }
        out.push('    }');
      } else if (mode === 'spa') {
        out.push('');
        out.push('    root /var/www/' + domain + ';');
        out.push('    index index.html;');
        out.push('');
        out.push('    location / {');
        out.push('        try_files $uri $uri/ /index.html;');
        out.push('    }');
      } else {
        out.push('');
        out.push('    root /var/www/' + domain + ';');
        out.push('    index index.html;');
        out.push('    location / { try_files $uri $uri/ =404; }');
      }

      if (on('staticcache')) {
        out.push('');
        out.push('    # Only valid because these filenames carry a content hash.');
        out.push('    location /assets/ {');
        out.push('        expires 1y;');
        out.push('        add_header Cache-Control "public, immutable" always;');
        out.push('        access_log off;');
        out.push('    }');
      }

      out.push('}');
      srvEl.textContent = out.join('\n') + '\n';
    }

    [domainEl, upEl].forEach((el) => el.addEventListener('input', render));
    [modeEl, certEl].forEach((el) => el.addEventListener('change', render));

    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        const want = new Set(presets[b.dataset.preset || 'none'] || []);
        items.forEach((i) => state.set(i.id, want.has(i.id)));
        items.forEach((i) => {
          const cb = root.querySelector<HTMLInputElement>(`#ngx-${i.id}`);
          if (cb) {
            cb.checked = on(i.id);
            cb.closest('.ngx__item')?.classList.toggle('ngx__item--off', !cb.checked);
          }
        });
        if (b.dataset.preset === 'spa') modeEl.value = 'spa';
        if (b.dataset.preset === 'api') modeEl.value = 'proxy';
        render();
      }),
    );

    root.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-http]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const target = btn.hasAttribute('data-copy-http') ? httpEl : srvEl;
        try {
          await navigator.clipboard.writeText(target.textContent || '');
          const old = btn.textContent;
          btn.textContent = '✓';
          setTimeout(() => (btn.textContent = old), 1200);
        } catch {
          /* clipboard unavailable; the pre is selectable anyway */
        }
      }),
    );

    render();
  });
</script>


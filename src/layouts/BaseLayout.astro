---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE, DEFAULT_LOCALE, LOCALES, localePath, type Lang } from '@/consts';
import '@/styles/global.css';
import '@/styles/theme.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  alternates?: Partial<Record<Lang, string>>;
  /** Path in the other locale to jump to from the header toggle. */
  switchHref?: string;
  active?: 'home' | 'start' | 'posts' | 'tags' | 'tools' | 'about';
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const props = Astro.props;
const { lang } = props;
const otherLang: Lang = LOCALES.find((l) => l !== lang) ?? DEFAULT_LOCALE;
const switchHref = props.switchHref ?? localePath(otherLang, '/');
const site = SITE.url.replace(/\/$/, '');

// Site-wide structured data.
const baseJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: site + '/',
    inLanguage: lang,
    description: props.description,
    publisher: {
      '@type': 'Person',
      name: SITE.author,
      url: SITE.humanUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.humanUrl,
    jobTitle: 'AI engineer',
    knowsAbout: ['Networking', 'Embedded systems', 'C', 'Rust', 'Self-hosting', 'AI agents'],
  },
];
const jsonLd = [...baseJsonLd, ...(props.jsonLd ?? [])];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead
      title={props.title}
      description={props.description}
      lang={lang}
      path={props.path}
      alternates={props.alternates}
      type={props.type}
      image={props.image}
      publishedTime={props.publishedTime}
      modifiedTime={props.modifiedTime}
      tags={props.tags}
      noindex={props.noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <Header lang={lang} switchHref={switchHref} switchLang={otherLang} active={props.active} />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // --- Reading progress -------------------------------------------------
      const bar = document.querySelector('.progress');
      const article = document.querySelector('article.prose');
      if (bar && article) {
        const update = () => {
          const r = article.getBoundingClientRect();
          const total = r.height - window.innerHeight;
          const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
          bar.style.setProperty('--progress', p.toFixed(4));
        };
        update();
        addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
      }

      // --- Heading anchors --------------------------------------------------
      document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => {
        if (h.querySelector('.heading-anchor')) return;
        const a = document.createElement('a');
        a.className = 'heading-anchor';
        a.href = '#' + h.id;
        a.textContent = '#';
        a.setAttribute('aria-hidden', 'true');
        a.tabIndex = -1;
        h.appendChild(a);
      });

      // --- Code chrome: language label + copy button ------------------------
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.closest('.codeblock')) return;
        const wrap = document.createElement('div');
        wrap.className = 'codeblock';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const head = document.createElement('div');
        head.className = 'codeblock__bar';
        const lang = (pre.getAttribute('data-language') || 'text').toLowerCase();
        const label = document.createElement('span');
        label.className = 'codeblock__lang';
        label.textContent = lang;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'codeblock__copy';
        btn.textContent = 'copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'copied';
            btn.dataset.copied = '1';
          } catch {
            btn.textContent = 'error';
          }
          setTimeout(() => {
            btn.textContent = 'copy';
            delete btn.dataset.copied;
          }, 1400);
        });

        head.append(label, btn);
        wrap.insertBefore(head, pre);
      });

      // --- TOC: highlight the section in view -------------------------------
      const tocLinks = Array.from(document.querySelectorAll('.toc a[href^="#"]'));
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const pairs = [];
        for (const a of tocLinks) {
          let id = a.hash.slice(1);
          try {
            id = decodeURIComponent(id);
          } catch {}
          const el = document.getElementById(id);
          if (el) pairs.push([el, a]);
        }
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const hit = pairs.find(([el]) => el === e.target);
              if (!hit) continue;
              for (const [, link] of pairs) {
                link.classList.remove('is-active');
                link.parentElement?.classList.remove('is-active');
              }
              hit[1].classList.add('is-active');
              hit[1].parentElement?.classList.add('is-active');
            }
          },
          { rootMargin: '-20% 0px -70% 0px' }
        );
        for (const [el] of pairs) obs.observe(el);

        // Fallback: light up the first entry until the observer fires.
        if (pairs.length && !document.querySelector('.toc a.is-active')) {
          pairs[0][1].classList.add('is-active');
          pairs[0][1].parentElement?.classList.add('is-active');
        }
      }
    </script>
  </body>
</html>

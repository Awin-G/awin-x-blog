{
  "name": "awinx-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "prebuild": "node scripts/check-content.mjs && node scripts/og.mjs",
    "postbuild": "node scripts/sitemap-lastmod.mjs && pagefind --site dist",
    "search:index": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "index": "node scripts/content-index.mjs",
    "find": "node scripts/content-index.mjs --query",
    "dupes": "node scripts/content-index.mjs --dupes 20",
    "crosspost": "node scripts/crosspost.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
